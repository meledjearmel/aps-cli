# Copiez ce fichier en .env (gitignore) pour eviter de retaper --base-url a
# chaque commande "aps login". Charge automatiquement depuis le repertoire
# courant (dotenv).

# URL de base AppStation, utilisee comme valeur par defaut par "aps login".
# En local via Laravel Herd : https://app-station.test
APPSTATION_BASE_URL=https://app-station.test

# Optionnel : override la resolution de cle API pour "aps doctor" quand vous
# etes dans un projet deja lie (appstation.conf.json present). Sinon la CLI lit
# appstation.conf.local.json ecrit par "aps init". Laissez vide sinon.
# REGISTRA_DEV_API_KEY=
# REGISTRA_API_KEY=
